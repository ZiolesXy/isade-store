VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_MIDTRANS_CLIENT_KEY=
VITE_MIDTRANS_IS_PRODUCTION=false

# Flag Midtrans (PLAN-UPDATE-v3 Tahap 2). Parse ketat: selain "true"/"false" dianggap false.
# Client (dibake saat build); mengontrol pilihan pembayaran di checkout:
#   true  = pelanggan bisa bayar online via Midtrans atau di kasir
#   false = hanya bayar di kasir
VITE_ENABLE_MIDTRANS=true
# Server (Edge Function create-order, set via `supabase secrets set` atau functions/.env).
# Saat false, endpoint create-order menolak payment_method=WEB_MIDTRANS (403);
# webhook Midtrans tetap menerima transaksi lama. Kunci Midtrans tidak wajib saat false.
ENABLE_MIDTRANS=false
